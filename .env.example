# Required for OpenRouter-backed agents. Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# Job search sources for --search: jobspy (default, free), reed, adzuna or apify.
# Use a comma-separated list to combine sources, e.g. JOB_SOURCE=jobspy,reed.
# The pipeline reads JOB_SOURCE from this file. Set it to jobspy,reed (default)
# or add apify only if you have an Apify account and want paid LinkedIn results.
JOB_SOURCE=jobspy,reed
# jobspy: comma-separated sites (linkedin, indeed, glassdoor) and optional Indeed/Glassdoor country
JOBSPY_SITES=linkedin,indeed
JOBSPY_COUNTRY=uk
# reed: free key at https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=
# adzuna: free keys at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# Optional Apify LinkedIn Jobs Scraper integration (JOB_SOURCE=apify)
APIFY_API_TOKEN=
APIFY_ACTOR_ID=curious_coder/linkedin-jobs-scraper
